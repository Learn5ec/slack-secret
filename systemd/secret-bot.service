[Unit]
Description=Secret Bot - Slack view-once secrets
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=web-h-034
WorkingDirectory=/home/web-h-034/Sync/slack-secret
ExecStart=/home/web-h-034/.nvm/versions/node/current/bin/tsx src/index.ts
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/web-h-034/Sync/slack-secret/.env
ExecStartPre=/home/web-h-034/.nvm/versions/node/current/bin/tsx bin/migrate.ts

[Install]
WantedBy=multi-user.target
