[Unit]
Description=Secret Bot - Slack view-once secrets
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=$whoami
WorkingDirectory=/home/$whoami/{path-to}/slack-secret
ExecStart=/home/$whoami/.nvm/versions/node/current/bin/tsx src/index.ts
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/$whoami/{path-to}/slack-secret/.env
ExecStartPre=/home/$whoami/.nvm/versions/node/current/bin/tsx bin/migrate.ts

[Install]
WantedBy=multi-user.target
