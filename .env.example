# ── Slack ──────────────────────────────────────────
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_TEAM_ID=T00000000

# ── Database ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=secret_bot
POSTGRES_USER=secret_bot
POSTGRES_PASSWORD=...
# Only used with docker-compose.shared-db.yml: name of the EXTERNAL Docker
# network the shared/centralized Postgres container lives on. The bot joins it
# to reach POSTGRES_HOST (the DB container's name/alias). Leave blank when your
# Postgres is reachable by plain hostname.
# POSTGRES_NETWORK=

# ── Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Encryption ─────────────────────────────────────
# Raw random key file generated by "npm run gen-key" (not encrypted - no passphrase to set)
MASTER_KEY_FILE=./src/crypto/keys/master.key

# ── App ────────────────────────────────────────────
LOG_LEVEL=info
# HTTP health endpoint port (bound to loopback in docker-compose).
HEALTH_PORT=9090
# Max upload size in bytes (default 25MB).
FILE_SIZE_MAX=26214400
# Run ClamAV (clamscan) on uploaded files. Requires clamav installed.
AV_ENABLED=true
# Directory where encrypted blobs are stored.
STORAGE_DIR=./encrypted-storage
